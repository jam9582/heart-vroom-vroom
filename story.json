      }
    },

    "s5": {
      "background": "night",
      "characters": ["genesis", "ionic"],
      "lines": [
        { "text": "[샘플] 장면 5. 밤의 주차장." },
        { "speaker": "genesis", "text": "[샘플] 제네시스의 대사입니다." },
        { "speaker": "ionic", "text": "[샘플] 아이오닉의 대사입니다." }
      ],
      "choice": {
        "prompt": "[샘플] 다섯 번째 선택지",
        "options": [
          { "text": "[샘플] 제네시스와 야경을 본다", "affection": { "genesis": 2 }, "next": "s6" },
          { "text": "[샘플] 아이오닉와 충전소에 간다", "affection": { "ionic": 2 }, "next": "s6" }
        ]
      }
    },

    "s6": {
      "background": "street",
      "characters": ["avante", "pony", "genesis", "ionic"],
      "lines": [
        { "text": "[샘플] 장면 6. 마지막 날, 모두가 모였습니다." },
        { "speaker": "avante", "text": "[샘플] 아반떼." },
        { "speaker": "pony", "text": "[샘플] 포니." },
        { "speaker": "genesis", "text": "[샘플] 제네시스." },
        { "speaker": "ionic", "text": "[샘플] 아이오닉." }
      ],
      "choice": {
        "prompt": "[샘플] 마지막 선택지 — 누구에게 갈까?",
        "options": [
          { "text": "[샘플] 아반떼에게", "affection": { "avante": 3 }, "next": "ENDING" },
          { "text": "[샘플] 포니에게", "affection": { "pony": 3 }, "next": "ENDING" },
          { "text": "[샘플] 제네시스에게", "affection": { "genesis": 3 }, "next": "ENDING" },
          { "text": "[샘플] 아이오닉에게", "affection": { "ionic": 3 }, "next": "ENDING" },
          { "text": "[샘플] 아무도 고르지 않는다", "affection": { "avante": -2, "pony": -2, "genesis": -2, "ionic": -2 }, "next": "ENDING" }
        ]
      }
    },

    "end_avante": {
      "background": "ending",
