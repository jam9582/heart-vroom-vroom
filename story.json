      "ending": { "type": "happy", "title": "포니 엔딩", "subtitle": "[샘플] 엔딩 부제" }
    },
    "end_genesis": {
      "background": "ending",
      "characters": ["genesis"],
      "lines": [
        { "speaker": "genesis", "text": "[샘플] 제네시스 해피 엔딩 대사입니다." }
      ],
