  "scenes": {
    "s1": {
      "background": "street",
      "characters": [],
      "lines": [
        { "text": "[샘플] 장면 1. 여기는 프롤로그 내레이션입니다." },
        { "text": "[샘플] 대사창을 클릭하거나 스페이스바를 누르면 다음 줄로 넘어갑니다." },
        { "speaker": "avante", "show": ["avante"], "text": "[샘플] 아반떼의 첫 대사입니다." },
        { "speaker": "pony", "show": ["avante", "pony"], "text": "[샘플] 포니의 첫 대사입니다." }
      ],
      "choice": {
        "prompt": "[샘플] 첫 번째 선택지",
        "options": [
          { "text": "[샘플] 아반떼에게 말을 건다", "affection": { "avante": 2 }, "next": "s2" },
          { "text": "[샘플] 포니에게 말을 건다", "affection": { "pony": 2 }, "next": "s2" },
          { "text": "[샘플] 둘 다 무시한다", "affection": { "avante": -1, "pony": -1 }, "next": "s2" }
        ]
      }
    },

    "s2": {
      "background": "garage",
      "characters": ["genesis"],
      "lines": [
        { "text": "[샘플] 장면 2. 정비소로 장소가 바뀌었습니다." },
        { "speaker": "genesis", "text": "[샘플] 제네시스의 첫 대사입니다." },
        { "speaker": "genesis", "expression": "default", "text": "[샘플] 표정(expression)은 images에 등록한 이름으로 바꿀 수 있습니다." }
      ],
      "choice": {
        "prompt": "[샘플] 두 번째 선택지",
        "options": [
          { "text": "[샘플] 제네시스에게 조언을 구한다", "affection": { "genesis": 2 }, "next": "s3" },
          { "text": "[샘플] 혼자 해결하겠다고 한다", "affection": { "genesis": -1, "avante": 1 }, "next": "s3" }
        ]
      }
    },

    "s3": {
      "background": "highway",
      "characters": ["ionic"],
      "lines": [
        { "text": "[샘플] 장면 3. 고속도로 위." },
        { "speaker": "ionic", "text": "[샘플] 아이오닉의 첫 대사입니다." },
        { "speaker": null, "text": "[샘플] speaker를 비우면 내레이션이 됩니다." }
      ],
      "choice": {
        "prompt": "[샘플] 세 번째 선택지",
        "options": [
          { "text": "[샘플] 아이오닉와 나란히 달린다", "affection": { "ionic": 2 }, "next": "s4" },
          { "text": "[샘플] 포니에게 연락한다", "affection": { "pony": 1, "ionic": -1 }, "next": "s4" },
          { "text": "[샘플] 아반떼를 떠올린다", "affection": { "avante": 1 }, "next": "s4" }
        ]
      }
    },

    "s4": {
      "background": "seaside",
      "characters": ["avante", "pony"],
      "lines": [
        { "text": "[샘플] 장면 4. 바닷가 드라이브." },
        { "speaker": "avante", "expression": "smile", "text": "[샘플] 아반떼 웃는 표정 (avante_smile.png가 없으면 기본 실루엣)." },
        { "speaker": "pony", "text": "[샘플] 포니의 대사입니다." }
      ],
      "choice": {
        "prompt": "[샘플] 네 번째 선택지",
        "options": [
          { "text": "[샘플] 아반떼 편을 든다", "affection": { "avante": 2, "pony": -1 }, "next": "s5" },
